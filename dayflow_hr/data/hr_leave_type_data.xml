<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Paid Leave Type -->
        <record id="holiday_status_paid" model="hr.leave.type">
            <field name="name">Paid Time Off (PTO)</field>
            <field name="color">4</field>
            <field name="icon_id" ref="hr_holidays.icon_3"/>
            <field name="leave_validation_type">hr</field>
            <field name="requires_allocation">no</field>
            <field name="employee_requests">yes</field>
            <field name="request_unit">day</field>
        </record>

        <!-- Sick Leave Type -->
        <record id="holiday_status_sick" model="hr.leave.type">
            <field name="name">Sick Leave</field>
            <field name="color">2</field>
            <field name="icon_id" ref="hr_holidays.icon_1"/>
            <field name="leave_validation_type">hr</field>
            <field name="requires_allocation">no</field>
            <field name="employee_requests">yes</field>
            <field name="request_unit">day</field>
        </record>

        <!-- Unpaid Leave Type -->
        <record id="holiday_status_unpaid" model="hr.leave.type">
            <field name="name">Unpaid Leave</field>
            <field name="color">1</field>
            <field name="icon_id" ref="hr_holidays.icon_2"/>
            <field name="leave_validation_type">hr</field>
            <field name="requires_allocation">no</field>
            <field name="employee_requests">yes</field>
            <field name="request_unit">day</field>
        </record>
    </data>
</odoo>
