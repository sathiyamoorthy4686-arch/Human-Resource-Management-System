<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Salary / Payroll Management Action and Views for HR Officers -->
    <record id="view_dayflow_salary_tree" model="ir.ui.view">
        <field name="name">dayflow.salary.employee.tree</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <tree string="Employee Salary &amp; Payroll Overview" create="0" delete="0">
                <field name="dayflow_emp_id"/>
                <field name="name"/>
                <field name="job_title"/>
                <field name="department_id"/>
                <field name="salary_type"/>
                <field name="salary_amount" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="bank_name"/>
                <field name="bank_account_no"/>
            </tree>
        </field>
    </record>

    <record id="action_dayflow_salary_mgmt" model="ir.actions.act_window">
        <field name="name">Salary &amp; Compensation</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_dayflow_salary_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage employee compensation and banking structures.
            </p>
        </field>
    </record>

    <!-- Menuitem for Salary Management -->
    <menuitem id="menu_dayflow_salary_item"
              name="Salary &amp; Compensation"
              parent="menu_dayflow_admin_mgmt"
              sequence="4"
              action="action_dayflow_salary_mgmt"
              groups="hr.group_hr_user,hr.group_hr_manager"/>
</odoo>
