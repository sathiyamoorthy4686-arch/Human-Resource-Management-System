<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Time-off / Leave Form View Extension -->
    <record id="view_dayflow_leave_form" model="ir.ui.view">
        <field name="name">dayflow.hr.leave.form</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="replace">
                <field name="remarks" placeholder="Provide reason or context for this time off request..."/>
            </xpath>
            <xpath expr="//group[hasclass('oe_title')]" position="after">
                <group string="HR / Manager Review" groups="hr.group_hr_user">
                    <field name="manager_comment" placeholder="Add approval remarks or feedback for the employee..."/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Time-off / Leave Tree View Extension -->
    <record id="view_dayflow_leave_tree" model="ir.ui.view">
        <field name="name">dayflow.hr.leave.tree</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="dayflow_leave_category" widget="badge"
                       decoration-success="dayflow_leave_category == 'paid'"
                       decoration-warning="dayflow_leave_category == 'sick'"
                       decoration-info="dayflow_leave_category == 'unpaid'"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="replace">
                <field name="remarks" optional="show"/>
                <field name="manager_comment" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
