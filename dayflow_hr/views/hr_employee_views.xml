<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Employee Form View Extension -->
    <record id="view_dayflow_employee_form" model="ir.ui.view">
        <field name="name">dayflow.hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Header status badge -->
            <xpath expr="//header" position="inside">
                <field name="current_dayflow_status" widget="badge" 
                       decoration-success="current_dayflow_status == 'present'" 
                       decoration-warning="current_dayflow_status == 'half_day'" 
                       decoration-info="current_dayflow_status == 'on_leave'" 
                       decoration-danger="current_dayflow_status == 'absent'"/>
            </xpath>

            <!-- Employee ID beside Job Title -->
            <xpath expr="//field[@name='job_title']" position="after">
                <h2>
                    <field name="dayflow_emp_id" placeholder="Dayflow Employee ID (e.g. DF-1001)" readonly="1"/>
                </h2>
            </xpath>

            <!-- Additional Salary and Emergency Info in Work Info tab -->
            <xpath expr="//page[@name='public']" position="after">
                <page name="dayflow_salary" string="Salary &amp; Compensation" groups="base.group_user">
                    <group>
                        <group string="Salary Structure">
                            <field name="salary_amount" readonly="not user_has_groups('hr.group_hr_user')"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="salary_type" readonly="not user_has_groups('hr.group_hr_user')"/>
                        </group>
                        <group string="Banking &amp; Direct Deposit">
                            <field name="bank_name" readonly="not user_has_groups('hr.group_hr_user')"/>
                            <field name="bank_account_no" readonly="not user_has_groups('hr.group_hr_user')"/>
                        </group>
                    </group>
                </page>
                
                <page name="dayflow_emergency" string="Emergency Contacts">
                    <group>
                        <group string="Primary Emergency Contact">
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_relation"/>
                            <field name="emergency_contact_phone"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Custom Employee Kanban View Extension -->
    <record id="view_dayflow_employee_kanban" model="ir.ui.view">
        <field name="name">dayflow.hr.employee.kanban</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_kanban_details')]" position="inside">
                <div class="mt-1">
                    <span class="badge rounded-pill text-bg-light border me-1">
                        <field name="dayflow_emp_id"/>
                    </span>
                    <field name="current_dayflow_status" widget="badge"
                           decoration-success="current_dayflow_status == 'present'" 
                           decoration-warning="current_dayflow_status == 'half_day'" 
                           decoration-info="current_dayflow_status == 'on_leave'" 
                           decoration-danger="current_dayflow_status == 'absent'"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Custom Employee Tree / List View Extension -->
    <record id="view_dayflow_employee_tree" model="ir.ui.view">
        <field name="name">dayflow.hr.employee.tree</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="dayflow_emp_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="current_dayflow_status" widget="badge"
                       decoration-success="current_dayflow_status == 'present'" 
                       decoration-warning="current_dayflow_status == 'half_day'" 
                       decoration-info="current_dayflow_status == 'on_leave'" 
                       decoration-danger="current_dayflow_status == 'absent'" optional="show"/>
                <field name="salary_amount" optional="hide" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>
</odoo>
