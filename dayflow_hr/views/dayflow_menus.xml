<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dayflow Dashboard Client Action -->
    <record id="action_dayflow_dashboard" model="ir.actions.client">
        <field name="name">Dayflow Dashboard</field>
        <field name="tag">dayflow_hr.dashboard</field>
        <field name="target">current</field>
    </record>

    <!-- My Profile Action (Opens current user's employee form) -->
    <record id="action_dayflow_my_profile" model="ir.actions.server">
        <field name="name">My Profile</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">
action = env['hr.employee'].search([('user_id', '=', env.user.id)], limit=1)
if action:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'My Dayflow Profile',
        'res_model': 'hr.employee',
        'res_id': action.id,
        'view_mode': 'form',
        'target': 'current',
    }
else:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Employees',
        'res_model': 'hr.employee',
        'view_mode': 'kanban,tree,form',
        'target': 'current',
    }
        </field>
    </record>

    <!-- My Attendance Action -->
    <record id="action_dayflow_my_attendance" model="ir.actions.act_window">
        <field name="name">My Attendance Records</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- My Time Off Action -->
    <record id="action_dayflow_my_leaves" model="ir.actions.act_window">
        <field name="name">My Time Off Requests</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'default_employee_id': active_id}</field>
    </record>

    <!-- All Employees Directory Action (HR Officer) -->
    <record id="action_dayflow_all_employees" model="ir.actions.act_window">
        <field name="name">Employee Directory</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Attendance Management Action (HR Officer) -->
    <record id="action_dayflow_attendance_mgmt" model="ir.actions.act_window">
        <field name="name">All Attendance Records</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- Time Off Approvals Action (HR Officer) -->
    <record id="action_dayflow_timeoff_mgmt" model="ir.actions.act_window">
        <field name="name">Leave Approvals &amp; Requests</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>

    <!-- Root Menu -->
    <menuitem id="menu_dayflow_root"
              name="Dayflow"
              sequence="10"
              web_icon="dayflow_hr,static/description/icon.png"
              action="action_dayflow_dashboard"/>

    <!-- Top Dashboard Menu -->
    <menuitem id="menu_dayflow_dashboard"
              name="Dashboard"
              parent="menu_dayflow_root"
              sequence="1"
              action="action_dayflow_dashboard"/>

    <!-- My Workspace Menu -->
    <menuitem id="menu_dayflow_my_workspace"
              name="My Workspace"
              parent="menu_dayflow_root"
              sequence="2"/>

    <menuitem id="menu_dayflow_my_profile_item"
              name="My Profile"
              parent="menu_dayflow_my_workspace"
              sequence="1"
              action="action_dayflow_my_profile"/>

    <menuitem id="menu_dayflow_my_attendance_item"
              name="My Attendance"
              parent="menu_dayflow_my_workspace"
              sequence="2"
              action="action_dayflow_my_attendance"/>

    <menuitem id="menu_dayflow_my_leaves_item"
              name="My Time Off"
              parent="menu_dayflow_my_workspace"
              sequence="3"
              action="action_dayflow_my_leaves"/>

    <!-- HR Management Menu (Officers only) -->
    <menuitem id="menu_dayflow_admin_mgmt"
              name="HR Administration"
              parent="menu_dayflow_root"
              sequence="3"
              groups="hr.group_hr_user,hr.group_hr_manager"/>

    <menuitem id="menu_dayflow_employees_item"
              name="Employee Directory"
              parent="menu_dayflow_admin_mgmt"
              sequence="1"
              action="action_dayflow_all_employees"
              groups="hr.group_hr_user,hr.group_hr_manager"/>

    <menuitem id="menu_dayflow_attendance_all_item"
              name="Attendance Logs"
              parent="menu_dayflow_admin_mgmt"
              sequence="2"
              action="action_dayflow_attendance_mgmt"
              groups="hr.group_hr_user,hr.group_hr_manager"/>

    <menuitem id="menu_dayflow_timeoff_all_item"
              name="Time Off Approvals"
              parent="menu_dayflow_admin_mgmt"
              sequence="3"
              action="action_dayflow_timeoff_mgmt"
              groups="hr.group_hr_user,hr.group_hr_manager"/>
</odoo>
