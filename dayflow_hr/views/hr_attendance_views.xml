<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance Tree View Extension -->
    <record id="view_dayflow_attendance_tree" model="ir.ui.view">
        <field name="name">dayflow.hr.attendance.tree</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="dayflow_status" widget="badge"
                       decoration-success="dayflow_status == 'present'"
                       decoration-warning="dayflow_status == 'half_day'"
                       decoration-info="dayflow_status == 'on_leave'"
                       decoration-danger="dayflow_status == 'absent'"/>
                <field name="dayflow_note" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Attendance Search View Extension -->
    <record id="view_dayflow_attendance_filter" model="ir.ui.view">
        <field name="name">dayflow.hr.attendance.filter</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='check_in']" position="after">
                <separator/>
                <filter string="Present" name="status_present" domain="[('dayflow_status', '=', 'present')]"/>
                <filter string="Half-day" name="status_half_day" domain="[('dayflow_status', '=', 'half_day')]"/>
            </xpath>
        </field>
    </record>
</odoo>
