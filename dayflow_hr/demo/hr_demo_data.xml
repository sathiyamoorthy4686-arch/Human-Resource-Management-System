        <!-- Sample Attendance Logs -->
        <record id="att_jordan_1" model="hr.attendance">
            <field name="employee_id" ref="emp_jordan_smith"/>
            <field name="check_in" eval="(datetime.now() - timedelta(days=2, hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="check_out" eval="(datetime.now() - timedelta(days=2)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="att_taylor_1" model="hr.attendance">
            <field name="employee_id" ref="emp_taylor_reed"/>
            <field name="check_in" eval="(datetime.now() - timedelta(days=1, hours=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="check_out" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="att_casey_1" model="hr.attendance">
            <field name="employee_id" ref="emp_casey_patel"/>
            <field name="check_in" eval="(datetime.now() - timedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <!-- Sample Leave Requests -->
        <!-- 1. Pending Paid Time Off request by Jordan Smith -->
        <record id="leave_jordan_pending" model="hr.leave">
            <field name="employee_id" ref="emp_jordan_smith"/>
            <field name="holiday_status_id" ref="holiday_status_paid"/>
            <field name="request_date_from" eval="(datetime.now() + timedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="request_date_to" eval="(datetime.now() + timedelta(days=7)).strftime('%Y-%m-%d')"/>
            <field name="date_from" eval="(datetime.now() + timedelta(days=5, hours=9)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_to" eval="(datetime.now() + timedelta(days=7, hours=18)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="number_of_days">3</field>
            <field name="name">Family Vacation &amp; Personal Travel</field>
            <field name="remarks">Annual family reunion trip. All tasks handed over to Taylor.</field>
            <field name="state">confirm</field>
        </record>

        <!-- 2. Approved Sick Leave for Taylor Reed -->
        <record id="leave_taylor_approved" model="hr.leave">
            <field name="employee_id" ref="emp_taylor_reed"/>
            <field name="holiday_status_id" ref="holiday_status_sick"/>
            <field name="request_date_from" eval="(datetime.now() - timedelta(days=4)).strftime('%Y-%m-%d')"/>
            <field name="request_date_to" eval="(datetime.now() - timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="date_from" eval="(datetime.now() - timedelta(days=4, hours=9)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="date_to" eval="(datetime.now() - timedelta(days=3, hours=18)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="number_of_days">2</field>
            <field name="name">Doctor Appointment and Recovery</field>
            <field name="remarks">Seasonal flu and dental checkup.</field>
            <field name="manager_comment">Approved. Take good care and recover well!</field>
            <field name="state">validate</field>
        </record>
    </data>
</odoo>
