<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Departments -->
        <record id="dep_dayflow_hr" model="hr.department">
            <field name="name">Human Resources</field>
        </record>
        <record id="dep_dayflow_eng" model="hr.department">
            <field name="name">Engineering</field>
        </record>
        <record id="dep_dayflow_mkt" model="hr.department">
            <field name="name">Marketing &amp; Growth</field>
        </record>
        <record id="dep_dayflow_ops" model="hr.department">
            <field name="name">Operations</field>
        </record>

        <!-- Users -->
        <!-- 1. HR Officer / Admin User: Alex Morgan -->
        <record id="user_alex_morgan" model="res.users">
            <field name="name">Alex Morgan</field>
            <field name="login">alex.morgan@dayflow.demo</field>
            <field name="email">alex.morgan@dayflow.demo</field>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('hr.group_hr_user'), ref('hr.group_hr_manager')])]"/>
        </record>

        <!-- 2. Employee User: Jordan Smith -->
        <record id="user_jordan_smith" model="res.users">
            <field name="name">Jordan Smith</field>
            <field name="login">jordan.smith@dayflow.demo</field>
            <field name="email">jordan.smith@dayflow.demo</field>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <!-- 3. Employee User: Taylor Reed -->
        <record id="user_taylor_reed" model="res.users">
