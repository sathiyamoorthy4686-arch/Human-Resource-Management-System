            <field name="mobile_phone">+1 555-0102</field>
            <field name="private_city">San Francisco</field>
            <field name="salary_amount">8500.00</field>
            <field name="salary_type">monthly</field>
            <field name="bank_name">First Republic Bank</field>
            <field name="bank_account_no">US89370400440532013000</field>
            <field name="emergency_contact_name">Sarah Morgan</field>
            <field name="emergency_contact_relation">Spouse</field>
            <field name="emergency_contact_phone">+1 555-0109</field>
        </record>

