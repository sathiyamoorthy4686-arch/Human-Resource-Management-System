            <field name="name">Jordan Smith</field>
            <field name="user_id" ref="user_jordan_smith"/>
            <field name="dayflow_emp_id">DF-1002</field>
            <field name="job_title">Senior Full Stack Engineer</field>
            <field name="department_id" ref="dep_dayflow_eng"/>
